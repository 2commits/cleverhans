{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleverhans.dev/spec/webhook/v1/authorize.request.json",
  "title": "authorize request (SPEC.md §14.4)",
  "type": "object",
  "required": ["webhook_version", "kind", "session_id", "action_id", "params", "principal"],
  "additionalProperties": false,
  "properties": {
    "webhook_version": { "const": 1 },
    "kind": { "const": "authorize" },
    "session_id": { "type": "string" },
    "action_id": {
      "type": "string",
      "description": "A registered action ID (SPEC.md §3)."
    },
    "params": {
      "type": "object",
      "description": "Fully validated, context-filled params — exactly what §9.3 receives in-process."
    },
    "principal": {
      "description": "Verbatim echo of the verify_session principal (§12.13)."
    }
  }
}
