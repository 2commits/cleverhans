{
  "name": "proposal_fold_executed",
  "description": "Confirm sends the §6.2 confirm_action wire shape; the answering executed state change carries the result and clears pending.",
  "spec": ["6.2", "7.3"],
  "steps": [
    { "server": { "type": "action_proposal", "proposal_id": "prop-1",
                  "action_id": "transaction.coBuyer.remove",
                  "params": { "transactionId": "tx_581" },
                  "block_type": "confirm", "slots": { "title": "Remove co-buyer" },
                  "preview": { "affected_count": 1 }, "context_seq": 0 } },
    { "client": { "confirm": "prop-1" } },
    { "assert_sent": { "type": "confirm_action", "proposal_id": "prop-1" } },
    { "assert": { "proposals": [ { "state": "validated", "working": true } ] } },
    { "server": { "type": "proposal_state_changed", "proposal_id": "prop-1",
                  "state": "executed", "result": { "removed": true } } },
    { "assert": { "pending_count": 0,
                  "proposals": [ { "state": "executed", "working": false,
                                    "result": { "removed": true } } ] } }
  ]
}
