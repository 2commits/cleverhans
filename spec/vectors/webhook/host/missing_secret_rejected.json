{
  "name": "missing_secret_rejected",
  "description": "§12.11: webhook endpoints are execution surface — a call without the service bearer secret MUST be rejected on every endpoint.",
  "spec": ["12.11", "14.2"],
  "layer": "webhook-host",
  "fixture": "co-buyer",
  "requests": [
    { "endpoint": "verify_session", "auth": "none",
      "body": { "webhook_version": 1, "session_id": "s_hostcheck_6", "headers": {} },
      "expect": { "status": { "$in": [401, 403] } } },
    { "endpoint": "execute", "auth": "none",
      "body": { "webhook_version": 1, "kind": "execute", "session_id": "s_hostcheck_6",
                "action_id": "transaction.coBuyer.remove",
                "params": { "transactionId": "tx_581" },
                "principal": { "user_id": "forged" },
                "idempotency_key": "ik_hostcheck_6a", "attempt": 1 },
      "expect": { "status": { "$in": [401, 403] } } },
    { "endpoint": "execute", "auth": "invalid",
      "body": { "webhook_version": 1, "kind": "execute", "session_id": "s_hostcheck_6",
                "action_id": "transaction.coBuyer.remove",
                "params": { "transactionId": "tx_581" },
                "principal": { "user_id": "forged" },
                "idempotency_key": "ik_hostcheck_6b", "attempt": 1 },
      "expect": { "status": { "$in": [401, 403] } } }
  ]
}
