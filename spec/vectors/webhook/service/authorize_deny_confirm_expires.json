{
  "name": "authorize_deny_confirm_expires",
  "description": "Webhook twin of revalidation_failure_expires: the authorize endpoint allows at propose time and denies at confirm time — the proposal expires, execute never fires (§12.9 over the wire).",
  "spec": ["14.4", "7.3", "12.9"],
  "layer": "webhook-service",
  "fixture": "co-buyer",
  "service_config": { "secret": "vector-secret" },
  "llm": [
    [ { "tool_call": { "name": "transaction.coBuyer.remove", "arguments": {} } } ]
  ],
  "host": {
    "authorize": [
      { "respond": { "status": 200, "body": { "decision": "allow" } } },
      { "respond": { "status": 200, "body": { "decision": "deny", "reason": "role revoked" } } }
    ]
  },
  "steps": [
    { "connect": {} },
    { "expect_connect": { "status": 101 } },
    { "send": { "type": "init", "spec_version": "0.1.0-draft",
                "context": { "route": "/transactions/tx_581",
                             "selected_record_id": "tx_581", "view_type": "detail" } } },
    { "expect": [] },
    { "send": { "type": "user_message", "text": "remove the co-buyer", "client_msg_id": "c-1" } },
    { "expect": [ { "type": "action_proposal", "proposal_id": { "$bind": "P" } } ] },
    { "send": { "type": "confirm_action", "proposal_id": { "$ref": "P" } } },
    { "expect": [
      { "type": "proposal_state_changed", "proposal_id": { "$ref": "P" }, "state": "expired" }
    ] }
  ],
  "expect_deliveries": [
    { "endpoint": "verify_session" },
    { "endpoint": "authorize" },
    { "endpoint": "dry_run" },
    { "endpoint": "authorize" }
  ]
}
