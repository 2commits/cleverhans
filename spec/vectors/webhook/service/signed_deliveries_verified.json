{
  "name": "signed_deliveries_verified",
  "description": "§14.2 payload signing: with a signing key configured, every delivery carries X-CleverHans-Signature and a host that REQUIRES valid signatures accepts the whole propose → confirm → execute flow — a forged or missing signature would 401 and break it.",
  "spec": ["14.2"],
  "layer": "webhook-service",
  "fixture": "co-buyer",
  "service_config": { "secret": "vector-secret", "signing_key": "vector-signing-key" },
  "llm": [
    [ { "tool_call": { "name": "transaction.coBuyer.remove", "arguments": {} } } ]
  ],
  "host": {},
  "steps": [
    { "connect": {} },
    { "expect_connect": { "status": 101 } },
    { "send": { "type": "init", "spec_version": "0.1.0-draft",
                "context": { "route": "/transactions/tx_581",
                             "selected_record_id": "tx_581", "view_type": "detail" } } },
    { "expect": [] },
    { "send": { "type": "user_message", "text": "remove the co-buyer", "client_msg_id": "c-1" } },
    { "expect": [ { "type": "action_proposal", "proposal_id": { "$bind": "P" } } ] },
    { "send": { "type": "confirm_action", "proposal_id": { "$ref": "P" } } },
    { "expect": [
      { "type": "proposal_state_changed", "proposal_id": { "$ref": "P" },
        "state": "executed", "result": { "$exact": { "removed": true } } }
    ] }
  ],
  "expect_deliveries": [
    { "endpoint": "verify_session",
      "headers": { "x-cleverhans-signature": { "$bind": "SIG0" } } },
    { "endpoint": "authorize",
      "headers": { "x-cleverhans-signature": { "$differs": "SIG0" } } },
    { "endpoint": "dry_run" },
    { "endpoint": "authorize" },
    { "endpoint": "dry_run" },
    { "endpoint": "execute",
      "headers": { "x-cleverhans-signature": { "$differs": "SIG0" } } }
  ]
}
