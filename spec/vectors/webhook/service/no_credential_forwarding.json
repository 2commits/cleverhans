{
  "name": "no_credential_forwarding",
  "description": "§12.12: the user's transport credentials cross the wire exactly once, in the verify_session body; every post-establishment delivery authenticates with the service secret only and carries no headers field.",
  "spec": ["12.12", "14.2", "14.3"],
  "layer": "webhook-service",
  "fixture": "co-buyer",
  "service_config": { "secret": "vector-secret" },
  "llm": [
    [ { "tool_call": { "name": "transaction.coBuyer.remove", "arguments": {} } } ]
  ],
  "host": {
    "verify_session": [ { "respond": { "status": 200, "body": { "principal": { "user_id": "u_1" } } } } ]
  },
  "steps": [
    { "connect": { "headers": { "authorization": "Bearer USER-SECRET-TOKEN" } } },
    { "expect_connect": { "status": 101 } },
    { "send": { "type": "init", "spec_version": "0.1.0-draft",
                "context": { "route": "/transactions/tx_581",
                             "selected_record_id": "tx_581", "view_type": "detail" } } },
    { "expect": [] },
    { "send": { "type": "user_message", "text": "remove the co-buyer", "client_msg_id": "c-1" } },
    { "expect": [ { "type": "action_proposal", "proposal_id": { "$bind": "P" } } ] },
    { "send": { "type": "confirm_action", "proposal_id": { "$ref": "P" } } },
    { "expect": [ { "type": "proposal_state_changed", "state": "executed" } ] }
  ],
  "expect_deliveries": [
    { "endpoint": "verify_session",
      "body": { "headers": { "authorization": "Bearer USER-SECRET-TOKEN" } } },
    { "endpoint": "authorize",
      "headers": { "authorization": "Bearer vector-secret" },
      "body": { "headers": { "$absent": true } } },
    { "endpoint": "dry_run",
      "headers": { "authorization": "Bearer vector-secret" },
      "body": { "headers": { "$absent": true } } },
    { "endpoint": "authorize",
      "headers": { "authorization": "Bearer vector-secret" },
      "body": { "headers": { "$absent": true } } },
    { "endpoint": "dry_run",
      "headers": { "authorization": "Bearer vector-secret" },
      "body": { "headers": { "$absent": true } } },
    { "endpoint": "execute",
      "headers": { "authorization": "Bearer vector-secret" },
      "body": { "headers": { "$absent": true } } }
  ]
}
