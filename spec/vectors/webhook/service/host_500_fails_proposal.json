{
  "name": "host_500_fails_proposal",
  "description": "§14.6: a 5xx from the execute endpoint is an answered call — the proposal moves to failed with a generic reason and the call is never retried (exactly one execute delivery).",
  "spec": ["14.6"],
  "layer": "webhook-service",
  "fixture": "co-buyer",
  "service_config": { "secret": "vector-secret" },
  "llm": [
    [ { "tool_call": { "name": "transaction.coBuyer.remove", "arguments": {} } } ]
  ],
  "host": {
    "execute": [ { "respond": { "status": 500, "body": { "error": "boom" } } } ]
  },
  "steps": [
    { "connect": {} },
    { "expect_connect": { "status": 101 } },
    { "send": { "type": "init", "spec_version": "0.1.0-draft",
                "context": { "route": "/transactions/tx_581",
                             "selected_record_id": "tx_581", "view_type": "detail" } } },
    { "expect": [] },
    { "send": { "type": "user_message", "text": "remove the co-buyer", "client_msg_id": "c-1" } },
    { "expect": [ { "type": "action_proposal", "proposal_id": { "$bind": "P" } } ] },
    { "send": { "type": "confirm_action", "proposal_id": { "$ref": "P" } } },
    { "expect": [
      { "type": "proposal_state_changed", "proposal_id": { "$ref": "P" }, "state": "failed" }
    ] }
  ],
  "expect_deliveries": [
    { "endpoint": "verify_session" },
    { "endpoint": "authorize" },
    { "endpoint": "dry_run" },
    { "endpoint": "authorize" },
    { "endpoint": "dry_run" },
    { "endpoint": "execute" }
  ]
}
