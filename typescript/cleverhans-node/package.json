{
  "name": "@cleverhans/node",
  "version": "0.1.0",
  "private": true,
  "description": "Host a CleverHans propose-only agent from a Node.js backend",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "napi": {
    "binaryName": "cleverhans-node"
  },
  "scripts": {
    "build": "napi build --platform --manifest-path ../../crates/cleverhans-node/Cargo.toml --output-dir .",
    "test": "pnpm run build && vitest run",
    "typecheck": "pnpm run build && tsc --noEmit"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
