{
  "name": "@cleverhans/node",
  "version": "0.2.0",
  "description": "Host a CleverHans propose-only agent from a Node.js backend",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2commits/cleverhans.git",
    "directory": "typescript/cleverhans-node"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "cleverhans-codegen": "bin/codegen.cjs"
  },
  "files": [
    "bin",
    "dist",
    "index.js",
    "index.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">= 18"
  },
  "napi": {
    "binaryName": "cleverhans-node",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build:native": "napi build --platform --manifest-path ../../crates/cleverhans-node/Cargo.toml --output-dir .",
    "build": "pnpm run build:native && tsc -p tsconfig.build.json",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dirs",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "pnpm run build && vitest run",
    "typecheck": "pnpm run build:native && tsc --noEmit"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
